# /etc/caddy/falch-vaskebyra.Caddyfile
# Samme mønster som landslagsdrakt.Caddyfile og neurochip.Caddyfile.
# Cloudflared-tunnelen «rpi» sender falch-vaskebyra.afrasum.dev hit.
#
# Merk: root må stå på sitenivå, ikke inne i handle-blokken, ellers finner
# file_server ingen rot og serverer fra Caddys arbeidskatalog.

{
	auto_https off
	admin off
}

:8008 {
	handle /api/teller {
		reverse_proxy 127.0.0.1:8007
	}

	root * /home/afras/projects/falch-vaskebyra

	# Roten er hele git-repoet, så bare selve nettsiden slippes ut.
	# .git/, deploy/, teller/, docs/ og README gir 404.
	@offentlig path / /index.html /css/* /js/* /assets/*
	handle @offentlig {
		file_server
	}
	handle {
		error 404
	}

	encode gzip zstd
}
